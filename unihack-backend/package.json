{
  "name": "unihack-backend",
  "version": "1.0.0",
  "private": true,
  "description": "UniHack AI Product Intelligence Platform - Enterprise Backend",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace=@unihack/api",
    "dev": "npm run dev --workspace=@unihack/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:seed": "tsx db/seeds/seed.ts",
    "clean": "npm run clean --workspaces --if-present"
  },
  "keywords": [
    "unihack",
    "fastify",
    "azure-sql",
    "product-intelligence",
    "service-bus"
  ],
  "author": "Vinay S. Bhadane & Sakshi P. Patil (MET Institute of Engineering, Nashik - B.E Computer Engineering 2028)",
  "contributors": [
    "Vinay S. Bhadane <vinaybhadane06@gmail.com>",
    "Sakshi P. Patil"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@types/node": "^20.11.24",
    "rimraf": "^5.0.5",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "rimraf": "^5.0.5",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
