# ==============================================================================
# CatalogForge Enterprise Backend Environment Variables Template
# Copy this file to .env in unihack-backend/ before running the server.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Core Configuration
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info
APP_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Azure SQL Database Configuration
# ------------------------------------------------------------------------------
# Full ADO.NET / MSSQL Connection String
AZURE_SQL_CONNECTION_STRING=Server=tcp:your-sql-server.database.windows.net,1433;Initial Catalog=catalogforge_db;Persist Security Info=False;User ID=your_user;Password=your_password;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;

# Or Granular Parameters:
AZURE_SQL_SERVER=your-sql-server.database.windows.net
AZURE_SQL_PORT=1433
AZURE_SQL_DATABASE=catalogforge_db
AZURE_SQL_USER=your_sql_username
AZURE_SQL_PASSWORD=your_sql_password
AZURE_SQL_ENCRYPT=true
AZURE_SQL_TRUST_SERVER_CERTIFICATE=false
AZURE_SQL_POOL_MAX=20
AZURE_SQL_POOL_MIN=2
AZURE_SQL_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# 3. Firebase Admin Authentication (Zero-Trust JWT Verification)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# ------------------------------------------------------------------------------
# 4. Multi-Modal Vision & Generative AI (Google Gemini)
# ------------------------------------------------------------------------------
# Used for Label OCR, Industrial Spec Extraction, and Zero-Hallucination Gatekeeper
GEMINI_API_KEY=your_google_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 5. Authoritative Web Search & OEM Intelligence (Brave Search API)
# ------------------------------------------------------------------------------
# Used for resolving authoritative manufacturer domains, PDFs, and spec sheets
BRAVE_SEARCH_API_KEY=your_brave_search_api_key

# ------------------------------------------------------------------------------
# 6. Transactional Email & Security 2FA Alerts (Resend / Brevo)
# ------------------------------------------------------------------------------
# Resend API Key for dispatching team invitations and 6-digit password OTPs
RESEND_API_KEY=your_resend_api_key
RESEND_SENDER_EMAIL=CatalogForge Security <security@catalogforge.tech>

# Brevo (Sendinblue) Fallback
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=admin@catalogforge.tech
BREVO_SENDER_NAME=CatalogForge Security

# ------------------------------------------------------------------------------
# 7. Security & CORS Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,https://catalogforge.tech

# ------------------------------------------------------------------------------
# 8. Local Development & Test Overrides
# ------------------------------------------------------------------------------
# Set to false in production to enforce strict Firebase JWT verification
ENABLE_MOCK_AUTH_IN_DEV=false
MOCK_AUTH_ROLE=admin
