# =============================================================================
# UniHack AI Product Intelligence Platform - Environment Configuration
# =============================================================================

# Server Environment
PORT=8000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Azure SQL Database Configuration
# Format 1: Direct Connection String (takes precedence if provided)
AZURE_SQL_CONNECTION_STRING=Server=tcp:unihack-sql-server.database.windows.net,1433;Initial Catalog=unihack_db;Persist Security Info=False;User ID=sqladmin;Password=YourPassword123!;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;

# Format 2: Discrete credentials (fallback if connection string not set)
AZURE_SQL_SERVER=unihack-sql-server.database.windows.net
AZURE_SQL_PORT=1433
AZURE_SQL_DATABASE=unihack_db
AZURE_SQL_USER=sqladmin
AZURE_SQL_PASSWORD=YourPassword123!
AZURE_SQL_ENCRYPT=true
AZURE_SQL_TRUST_SERVER_CERTIFICATE=false
AZURE_SQL_POOL_MAX=20
AZURE_SQL_POOL_MIN=2
AZURE_SQL_TIMEOUT_MS=30000

# Firebase Admin Authentication
# Optional: Path to Firebase Service Account JSON file (takes precedence if set)
FIREBASE_SERVICE_ACCOUNT_PATH=
# Or discrete Firebase Admin credentials:
FIREBASE_PROJECT_ID=unihack-intelligence-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@unihack-intelligence-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Security & CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,https://catalogforge.azurewebsites.net
API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_TIME_WINDOW_MS=60000

# Feature Flags & Dev Overrides
# Set to 'true' in local dev to bypass Firebase token verification with a mock reviewer user if needed
ENABLE_MOCK_AUTH_IN_DEV=false
MOCK_AUTH_ROLE=admin
